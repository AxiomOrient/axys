{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/component-catalog.schema.json",
  "title": "ComponentCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "vstack",
              "hstack",
              "card",
              "text",
              "textField",
              "secureField",
              "button",
              "divider",
              "spacer",
              "image",
              "icon"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
