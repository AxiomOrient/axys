{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/v2/flow-spec.schema.json",
  "title": "FlowSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "flowId",
    "title",
    "entryScreen",
    "screens",
    "transitions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.1"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "entryScreen": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "deepLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deepLink"
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/screenRef"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "$defs": {
    "screenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "entry",
            "step",
            "modal",
            "terminal"
          ]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "event",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "guard": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        }
      }
    },
    "deepLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "targetScreen"
      ],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^\\/\\S*$"
        },
        "targetScreen": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  }
}
