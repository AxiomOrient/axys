{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/dsctl.config.schema.json",
  "title": "DSCTLConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectRoot",
    "screenDocDir",
    "screenSpecDir",
    "tokenDir",
    "catalogPath",
    "buildDir",
    "defaultPlatforms"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "projectRoot": {
      "type": "string"
    },
    "screenDocDir": {
      "type": "string"
    },
    "screenSpecDir": {
      "type": "string"
    },
    "tokenDir": {
      "type": "string"
    },
    "catalogPath": {
      "type": "string"
    },
    "buildDir": {
      "type": "string"
    },
    "defaultPlatforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ios",
          "android",
          "html"
        ]
      },
      "uniqueItems": true
    }
  }
}
