{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/current/review-checklist.schema.json",
  "title": "ReviewChecklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewSetId",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.1"
    },
    "reviewSetId": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "description",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "structure",
            "semantics",
            "tokens",
            "motion",
            "native-viability"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "evidenceTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
