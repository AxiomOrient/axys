{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/current/component-registry.schema.json",
  "title": "ComponentRegistryV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryId",
    "namespace",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.1"
    },
    "registryId": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "web",
        "native"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "primitive",
            "mobile",
            "flow-shell"
          ]
        },
        "allowedProps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propDef"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slotDef"
          }
        },
        "stateRequirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "navigation": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "motionSlots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reviewHints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "web": {
          "$ref": "#/$defs/webMapping"
        },
        "native": {
          "$ref": "#/$defs/nativeMapping"
        }
      }
    },
    "propDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "enum",
            "token",
            "imageRef",
            "iconRef"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "slotDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "accepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "webMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "importPath",
        "exportName"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "private-shadcn-registry"
          ]
        },
        "importPath": {
          "type": "string",
          "minLength": 1
        },
        "exportName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nativeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ios",
        "android"
      ],
      "properties": {
        "ios": {
          "$ref": "#/$defs/platformMapping"
        },
        "android": {
          "$ref": "#/$defs/platformMapping"
        }
      }
    },
    "platformMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
